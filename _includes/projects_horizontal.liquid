<div class="col mb-4">
  <div class="card h-100 hoverable project-card">
    <div class="row no-gutters">
      <a
        class="project-card-main d-flex w-100"
        href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
      >
        {% if project.img %}
          <div class="col-md-6">
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img" %}
          </div>
        {% endif %}
        <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ project.title }}</h3>
            <p class="card-text">{{ project.description }}</p>
            {% if project.tags and project.tags.size > 0 %}
              <div class="project-tags">
                {% for tag in project.tags %}
                  <span>{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </a>
    </div>

    {% if project.links or project.github %}
      <div class="project-card-links">
        {% if project.github %}
          <a
            class="project-link"
            href="{{ project.github }}"
            target="_blank"
            rel="external noopener"
            title="Code repository"
          >
            <i class="fa-brands fa-github"></i>
            <span>Code</span>
          </a>
        {% endif %}
        {% include project_links.liquid links=project.links %}
      </div>
    {% endif %}
  </div>
</div>
