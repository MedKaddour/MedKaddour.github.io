<div class="col">
  <div class="card h-100 hoverable project-card">
    <a
      class="project-card-main"
      href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
    >
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.tags and project.tags.size > 0 %}
          <div class="project-tags">
            {% for tag in project.tags %}
              <span>{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </a>

    {% if project.links or project.github %}
      <div class="project-card-links">
        {% if project.github %}
          <a
            class="project-link"
            href="{{ project.github }}"
            target="_blank"
            rel="external noopener"
            title="Code repository"
          >
            <i class="fa-brands fa-github"></i>
            <span>Code</span>
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </a>
        {% endif %}
        {% include project_links.liquid links=project.links %}
      </div>
    {% endif %}
  </div>
</div>
